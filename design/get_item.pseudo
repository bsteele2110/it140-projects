# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

# TODO 1: Identify the information the item retrieval process needs.
# Consider the player's current room, inventory, and item command.
SET current_room = "Tech Workshop"
SET inventory = []
SET rooms = {
    'Tech Workshop': {'item': 'Soldering Iron'},
    'Security Office': {'item': 'Security Keycard'},
    'Executive Suite': {'item': 'Encrypted USB'},
    'Breakroom': {'item': 'Energy Drink'},
    'R&D Lab': {'item': 'EMP Grenade'},
    'Basement Vault': {'item': 'Decryption Deck'}
}

# TODO 2: Prompt for and receive the player's item command.
PROMPT "Enter item command (e.g., 'get Soldering Iron'): "
INPUT user_command
SET command_parts = SPLIT(user_command, " ", 1)
SET item_name = command_parts[1]

# TODO 3: Validate whether the requested item is in the current room.
# Show the decision clearly.
IF 'item' IS IN rooms[current_room] AND LOWERCASE(rooms[current_room]['item']) == LOWERCASE(item_name):
    
    # TODO 4: Describe what happens when the item command is valid.
    # Include updating inventory and feedback output.
    APPEND rooms[current_room]['item'] TO inventory
    OUTPUT rooms[current_room]['item'] + " retrieved!"
    REMOVE 'item' FROM rooms[current_room]
    
ELSE:
    
    # TODO 5: Describe what happens when the item command is invalid.
    # Include the output the player should receive.
    OUTPUT "Can't get " + item_name + "!"
    
ENDIF

# TODO 6: Show how item retrieval fits into repeated gameplay.
# The final game continues accepting commands until a required ending occurs.
WHILE game_is_running IS True:
    CALL get_item_process(current_room, inventory, user_command)
ENDWHILE

